# Copy to .env and fill in. Never commit .env.

# Identifiable User-Agent sent with every request (include a contact URL or email).
SCRAPEMEND_USER_AGENT="scrapemend/0.1 (+https://example.com/contact)"

# Where raw response snapshots are stored (filesystem store).
SCRAPEMEND_SNAPSHOT_DIR=./snapshots

# Run metadata database. SQLite by default; Postgres needs the `postgres` extra.
SCRAPEMEND_DB_URL=sqlite:///scrapemend.db

# Repair provider: none | anthropic
SCRAPEMEND_REPAIR_PROVIDER=none

# Only needed with the `anthropic` extra and SCRAPEMEND_REPAIR_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
